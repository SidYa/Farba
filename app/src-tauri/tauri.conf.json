{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farba",
  "version": "1.0.0",
  "identifier": "ua.sergii.farba",
  "build": {
    "beforeDevCommand": "pnpm wasm && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Farba",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#2b2b2b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Sergii Sidko",
    "copyright": "© 2026 Sergii Sidko",
    "license": "GPL-3.0-or-later",
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "shortDescription": "Farba image editor",
    "longDescription": "A fast, lightweight raster image editor for Windows.",
    "fileAssociations": [
      {
        "ext": ["ora"],
        "name": "OpenRaster image",
        "description": "Layered image (OpenRaster)",
        "mimeType": "image/openraster",
        "role": "Editor"
      },
      {
        "ext": ["xcf"],
        "name": "GIMP image",
        "description": "Layered image (GIMP XCF)",
        "mimeType": "image/x-xcf",
        "role": "Editor"
      },
      {
        "ext": ["psd"],
        "name": "Photoshop image",
        "description": "Layered image (Photoshop PSD)",
        "mimeType": "image/vnd.adobe.photoshop",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "languages": ["English", "Ukrainian"],
        "displayLanguageSelector": false
      }
    }
  }
}
